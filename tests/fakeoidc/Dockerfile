FROM golang:1.27.1-trixie@sha256:8f58fd67ea075142d947a60e0caa4317746a55118d312f027793d382c7741734 AS build

WORKDIR /go/src/app
COPY go.mod go.sum ./
RUN go mod download

COPY ./tests/fakeoidc/ ./tests/fakeoidc/
RUN CGO_ENABLED=0 go build -o /go/bin/app ./tests/fakeoidc

FROM golang:1.27.1-trixie@sha256:8f58fd67ea075142d947a60e0caa4317746a55118d312f027793d382c7741734

COPY --from=build /go/bin/app /
ENTRYPOINT ["/app"]
